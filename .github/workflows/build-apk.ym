name: Build APK Android

on:
  push:
    branches:
      - main
      - master
  pull_request:
    branches:
      - main
      - master
  workflow_dispatch:

jobs:
  build:
    name: Build APK (Debug)
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: 📥 Checkout Code
        uses: actions/checkout@v4

      - name: 🟢 Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: 📦 Install Dependencies
        run: npm ci

      - name: ☕ Setup JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '21'
          cache: 'gradle'

      - name: 🔄 Sync with Capacitor
        run: npx cap sync android

      - name: 🔑 Grant Gradle Execute Permission
        run: chmod +x www/android/gradlew

      - name: 🔨 Build Debug APK
        run: |
          cd www/android
          ./gradlew assembleDebug --no-daemon

      - name: 📤 Upload Debug APK
        uses: actions/upload-artifact@v4
        if: success()
        with:
          name: app-debug
          path: www/android/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 7

      - name: ✅ Build Success
        if: success()
        run: echo "✅ APK built successfully!"

      - name: ❌ Build Failed
        if: failure()
        run: echo "❌ Build failed!" && exit 1